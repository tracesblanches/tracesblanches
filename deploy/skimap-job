#!/bin/sh
# One pipeline task for some sites, then publication of their packs (CronJobs on the server,
# image skimap-pipeline). Steps run one at a time on the shared volume (flock), a failed
# step keeps the previous outputs of its layer, and the pack is published anyway when it
# verifies (skimap-server publish refuses one that does not).
#
#   skimap-job build-all <site>...   # everything (heavy)
#   skimap-job snow      <site>...   # snow J-1, routing rasters
#   skimap-job bera      [<site>...] # avalanche bulletin (default: every built site of
#                                    # the registry whose massif has a BERA)
#   skimap-job status    [<site>...] # trail status, personal sources (default: every
#                                    # built groomed station of the registry with a
#                                    # readable status source; ENJ domains detected
#                                    # first by `skimap enj-domaines`)
#   skimap-job meteo     <site>...   # hourly weather (personal sources)
#   skimap-job refresh   [<site>...] # station cards and titles of France (once), huts of
#                                    # the sites (default: every built site); daily
#                                    # 1 Nov-30 Apr, weekly otherwise; then the packs of
#                                    # the sites whose content changed
#   skimap-job catchup                                 # every site: AROME weather of the
#                                                      # latest run, then only what failed,
#                                                      # is altered or old (build-all
#                                                      # --stale), each site published as
#                                                      # soon as built, then every pack
#   skimap-job france-basemap                          # France basemap (X20), renewed at
#                                                      # most weekly, then published
#
# Environment: SKIMAP_DATA_DIR (pipeline data), SKIMAP_STORE (published store),
# METEOFRANCE_API_KEY and the other keys of the pipeline.
set -u
task=${1:?task}
shift
: "${SKIMAP_DATA_DIR:?}" "${SKIMAP_STORE:?}"

exec 9>"$SKIMAP_DATA_DIR/.pipeline.lock"
flock 9

rc=0
step() {
  echo "+ $*"
  "$@" || { rc=$?; echo "FAILED ($rc): $*"; return 1; }
}

# France-wide part of `refresh`, once for all the sites; when a source is broken it fails
# (previous values kept, data/out/france/refresh/status.json) and the packs are still
# rebuilt and published: the job then ends non-zero.
if [ "$task" = refresh ]; then
  step skimap refresh "$@"
  # Without explicit sites, rebuild the packs of the sites the refresh changed
  # (data/out/france/refresh/changed_sites.txt, one identifier per line).
  if [ $# -eq 0 ] && [ -f "$SKIMAP_DATA_DIR/out/france/refresh/changed_sites.txt" ]; then
    # shellcheck disable=SC2046
    set -- $(cat "$SKIMAP_DATA_DIR/out/france/refresh/changed_sites.txt")
  fi
fi

# Catch-up of every site of the registry (deploy/catchup-cronjob.yaml): the failed,
# altered (fingerprints) and old steps only, then every pack; the publication sends only
# the packs that changed. The packs are published even when some step is still failing
# (its previous outputs, with their date, are in the pack).
if [ "$task" = catchup ]; then
  # Weather of every site at the latest AROME run (idempotent: nothing written when the
  # run has not changed); the packs that change are published below.
  step skimap meteo-refresh
  # Each site is published as soon as it is built (#172): a pass killed later (memory,
  # deadline) keeps them. A site whose build killed the process twice is set aside
  # (status.json, alert) and tried again when its inputs change or a day later; the
  # others go first. The final publication takes the packs built by the other tasks.
  step skimap build-all --all --stale --jobs "${SKIMAP_CATCHUP_JOBS:-2}" \
    --max-age-hours "${SKIMAP_CATCHUP_MAX_AGE_HOURS:-168}" \
    --stop-after-min "${SKIMAP_CATCHUP_STOP_AFTER_MIN:-240}" \
    --publish-with "skimap-server publish"
  step skimap-server publish --all-in "$SKIMAP_DATA_DIR/out"
  exit $rc
fi

# France basemap (X20, deploy/france-basemap-cronjob.yaml): kept while the Protomaps
# build in use is recent (nothing rewritten, nothing published), else rebuilt and
# published (`publish-france` writes only the files that changed).
if [ "$task" = france-basemap ]; then
  step skimap france-basemap &&
    step skimap-server publish-france "$SKIMAP_DATA_DIR/out/france-basemap"
  exit $rc
fi

# bera and status without explicit sites: the sites of the registry they apply to
# (`skimap sites --ids`: BERA massif / readable status source, pipeline outputs on the
# volume; the other sites get these layers from build-all and the catch-up).
if [ $# -eq 0 ] && { [ "$task" = bera ] || [ "$task" = status ]; }; then
  # Status: first the ENJ domains, detected from the ENJ itineraries (cached one day,
  # registry rewritten only when it changed); on failure the previous registry is kept.
  if [ "$task" = status ]; then
    step skimap enj-domaines
  fi
  if ! sites=$(skimap sites --ids --built "--$task"); then
    echo "FAILED: skimap sites --ids --built --$task" >&2
    exit 1
  fi
  [ -n "$sites" ] || echo "no built site for $task"
  # shellcheck disable=SC2086
  set -- $sites
fi

for site in "$@"; do
  case "$task" in
    build-all) step skimap build-all "$site" ;;
    snow) step skimap snow "$site" && step skimap offpiste-prepare "$site" && step skimap build-pack "$site" ;;
    bera) step skimap bera "$site" && step skimap build-pack "$site" ;;
    status) step skimap status-poll "$site" && step skimap build-pack "$site" ;;
    meteo) step skimap meteo "$site" && step skimap build-pack "$site" ;;
    refresh) step skimap build-pack "$site" ;;
    *) echo "unknown task $task" >&2; exit 2 ;;
  esac
  if [ -f "$SKIMAP_DATA_DIR/out/$site/pack/manifest.json" ]; then
    step skimap-server publish "$SKIMAP_DATA_DIR/out/$site/pack"
  fi
done
exit $rc
