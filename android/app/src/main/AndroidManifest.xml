<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline first: a pack is displayed without any network request. INTERNET comes
         from the module :sync only (pack download and update, K2; its manifest says why);
         MapLibre is kept offline (MapLibre.setConnected(false), file:// styles). -->

    <!-- One coarse position, on request, for "Domaines les plus proches". No tracking. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skimap">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The morning and the plan of the day (J5, K9, K10). -->
        <activity
            android:name=".day.DayActivity"
            android:exported="false" />
        <!-- The one location service of an outing (K4, report 09), module :tracking. -->
        <service
            android:name=".guidance.SkiTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
