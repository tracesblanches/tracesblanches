<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Strava (K11): the OAuth exchange through skimap-server and the upload of the trace,
         on a user gesture (« Envoyer », « Connecter Strava ») or in a WorkManager job that
         waits for the network. Nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Health Connect (K11): the outing written as a skiing session with its route. Never
         read: the app keeps no health data of its own. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE_ROUTE" />

    <queries>
        <!-- Health Connect as an app (Android 13 and older). -->
        <package android:name="com.google.android.apps.healthdata" />
        <!-- A browser for the Strava sign-in. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
